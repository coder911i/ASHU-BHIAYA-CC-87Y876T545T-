# Copy to .env.local for local development and replace every example value.
# Do not use these sample credentials in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_JWT_SECRET=local-only-change-this-secret-to-a-random-value-32-chars-minimum
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=local-only-change-this-password-12-chars-minimum
# Optional: created only during first database initialization.
ADMIN_MANAGER_EMAIL=manager@example.com
ADMIN_MANAGER_PASSWORD=local-only-manager-password-12-chars-minimum
ADMIN_NOTIFICATION_EMAIL=ops@example.com

# SQLite local path. For production, migrate to a persistent managed database.
# DATABASE_PATH=./data/vsr.db

# Notification adapters are not implemented; these flags alone do not send messages.
EMAIL_PROVIDER=mock
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# WHATSAPP_ENABLED=false
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# SMS_ENABLED=false
# SMS_API_KEY=
